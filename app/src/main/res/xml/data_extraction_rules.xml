<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the profile list (it holds refresh tokens) out of cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="abs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="abs.xml" />
    </device-transfer>
</data-extraction-rules>
